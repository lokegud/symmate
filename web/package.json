{
	"name": "symmate-web",
	"private": true,
	"version": "0.0.1",
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"dev:platform": "bun run --cwd apps/platform dev",
		"dev:vestibule": "bun run --cwd apps/vestibule dev",
		"dev:operator": "bun run --cwd apps/operator dev",
		"build:platform": "bun run --cwd apps/platform build",
		"build:vestibule": "bun run --cwd apps/vestibule build",
		"build:operator": "bun run --cwd apps/operator build",
		"check": "bun run --cwd apps/platform check && bun run --cwd apps/vestibule check && bun run --cwd apps/operator check"
	}
}
